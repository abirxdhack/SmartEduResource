#copyright@abirxdhack
#git profile https://github.com/abirxdhack
#repo url https://github.com/abirxdhack/SmartEduResource
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
FileETag MTime Size

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "\.(php|phtml|phar)$">
  <If "%{REQUEST_URI} =~ m#^/(covers|r|data)/#">
    Require all denied
  </If>
</FilesMatch>
